// ============================================================
// Agent Platform Accelerator - Foundry Agent with VNet
// Pattern: foundry-agent-vnet
// Region: {{ region }}
// Environment: {{ environment }}
// ============================================================

targetScope = 'resourceGroup'

@description('Project name used for resource naming')
param projectName string = '{{ project_name }}'

@description('Azure region for deployment')
param location string = '{{ region }}'

@description('Environment (dev, staging, prod)')
@allowed(['dev', 'staging', 'prod'])
param environment string = '{{ environment }}'

@description('VNet address prefix')
param vnetAddressPrefix string = '10.0.0.0/16'

@description('Default subnet prefix')
param defaultSubnetPrefix string = '10.0.0.0/24'

@description('Private endpoints subnet prefix')
param peSubnetPrefix string = '10.0.1.0/24'

var resourcePrefix = '${projectName}-${environment}'
var tags = {
  environment: environment
  project: projectName
  'managed-by': 'agent-platform-accelerator'
}

// ============================================================
// Managed Identity
// ============================================================
resource managedIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: '${resourcePrefix}-identity'
  location: location
  tags: tags
}

// ============================================================
// Virtual Network
// ============================================================
resource vnet 'Microsoft.Network/virtualNetworks@2024-01-01' = {
  name: '${resourcePrefix}-vnet'
  location: location
  tags: tags
  properties: {
    addressSpace: {
      addressPrefixes: [vnetAddressPrefix]
    }
    subnets: [
      {
        name: 'default'
        properties: {
          addressPrefix: defaultSubnetPrefix
          networkSecurityGroup: { id: defaultNsg.id }
        }
      }
      {
        name: 'private-endpoints'
        properties: {
          addressPrefix: peSubnetPrefix
          networkSecurityGroup: { id: peNsg.id }
        }
      }
    ]
  }
}

// ============================================================
// Network Security Groups
// ============================================================
resource defaultNsg 'Microsoft.Network/networkSecurityGroups@2024-01-01' = {
  name: '${resourcePrefix}-default-nsg'
  location: location
  tags: tags
  properties: {
    securityRules: [
      {
        name: 'DenyAllInbound'
        properties: {
          priority: 4096
          direction: 'Inbound'
          access: 'Deny'
          protocol: '*'
          sourcePortRange: '*'
          destinationPortRange: '*'
          sourceAddressPrefix: '*'
          destinationAddressPrefix: '*'
        }
      }
    ]
  }
}

resource peNsg 'Microsoft.Network/networkSecurityGroups@2024-01-01' = {
  name: '${resourcePrefix}-pe-nsg'
  location: location
  tags: tags
  properties: {
    securityRules: []
  }
}

// ============================================================
// Monitoring
// ============================================================
{% if enable_monitoring %}
resource logAnalytics 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: '${resourcePrefix}-logs'
  location: location
  tags: tags
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
  }
}

resource appInsights 'Microsoft.Insights/components@2020-02-02' = {
  name: '${resourcePrefix}-insights'
  location: location
  kind: 'web'
  tags: tags
  properties: {
    Application_Type: 'web'
    WorkspaceResourceId: logAnalytics.id
  }
}
{% endif %}

// ============================================================
// Key Vault (with Private Endpoint)
// ============================================================
resource keyVault 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: '${resourcePrefix}-kv'
  location: location
  tags: tags
  properties: {
    sku: { family: 'A', name: 'standard' }
    tenantId: subscription().tenantId
    enableRbacAuthorization: true
    enableSoftDelete: true
    softDeleteRetentionInDays: 7
    networkAcls: {
      defaultAction: 'Deny'
      bypass: 'AzureServices'
    }
  }
}

resource keyVaultPe 'Microsoft.Network/privateEndpoints@2024-01-01' = {
  name: '${resourcePrefix}-kv-pe'
  location: location
  tags: tags
  properties: {
    subnet: {
      id: vnet.properties.subnets[1].id
    }
    privateLinkServiceConnections: [
      {
        name: '${resourcePrefix}-kv-psc'
        properties: {
          privateLinkServiceId: keyVault.id
          groupIds: ['vault']
        }
      }
    ]
  }
}

// ============================================================
// Storage Account (with Private Endpoint)
// ============================================================
resource storageAccount 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: replace('${resourcePrefix}st', '-', '')
  location: location
  tags: tags
  sku: { name: 'Standard_LRS' }
  kind: 'StorageV2'
  properties: {
    minimumTlsVersion: 'TLS1_2'
    supportsHttpsTrafficOnly: true
    allowBlobPublicAccess: false
    networkAcls: {
      defaultAction: 'Deny'
      bypass: 'AzureServices'
    }
  }
}

resource storagePe 'Microsoft.Network/privateEndpoints@2024-01-01' = {
  name: '${resourcePrefix}-st-pe'
  location: location
  tags: tags
  properties: {
    subnet: {
      id: vnet.properties.subnets[1].id
    }
    privateLinkServiceConnections: [
      {
        name: '${resourcePrefix}-st-psc'
        properties: {
          privateLinkServiceId: storageAccount.id
          groupIds: ['blob']
        }
      }
    ]
  }
}

// ============================================================
// Azure OpenAI (with Private Endpoint)
// ============================================================
resource openai 'Microsoft.CognitiveServices/accounts@2024-04-01-preview' = {
  name: '${resourcePrefix}-openai'
  location: location
  tags: tags
  kind: 'OpenAI'
  sku: { name: 'S0' }
  properties: {
    customSubDomainName: '${resourcePrefix}-openai'
    publicNetworkAccess: 'Disabled'
    networkAcls: {
      defaultAction: 'Deny'
    }
  }
}

resource openaiPe 'Microsoft.Network/privateEndpoints@2024-01-01' = {
  name: '${resourcePrefix}-openai-pe'
  location: location
  tags: tags
  properties: {
    subnet: {
      id: vnet.properties.subnets[1].id
    }
    privateLinkServiceConnections: [
      {
        name: '${resourcePrefix}-openai-psc'
        properties: {
          privateLinkServiceId: openai.id
          groupIds: ['account']
        }
      }
    ]
  }
}

{% for model in model_deployments %}
resource openaiDeployment{{ loop.index }} 'Microsoft.CognitiveServices/accounts/deployments@2024-04-01-preview' = {
  parent: openai
  name: '{{ model.name }}'
  sku: {
    name: 'Standard'
    capacity: {{ model.capacity }}
  }
  properties: {
    model: {
      format: 'OpenAI'
      name: '{{ model.model }}'
    }
  }
}
{% endfor %}

// ============================================================
// AI Foundry Hub & Project
// ============================================================
resource aiHub 'Microsoft.MachineLearningServices/workspaces@2024-04-01' = {
  name: '${resourcePrefix}-hub'
  location: location
  tags: tags
  kind: 'Hub'
  sku: { name: 'Basic', tier: 'Basic' }
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: {
      '${managedIdentity.id}': {}
    }
  }
  properties: {
    friendlyName: '${projectName} AI Hub (${environment})'
    storageAccount: storageAccount.id
    keyVault: keyVault.id
    {% if enable_monitoring %}
    applicationInsights: appInsights.id
    {% endif %}
    primaryUserAssignedIdentity: managedIdentity.id
    managedNetwork: {
      isolationMode: 'AllowInternetOutbound'
    }
  }
}

resource aiProject 'Microsoft.MachineLearningServices/workspaces@2024-04-01' = {
  name: '${resourcePrefix}-project'
  location: location
  tags: tags
  kind: 'Project'
  sku: { name: 'Basic', tier: 'Basic' }
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: {
      '${managedIdentity.id}': {}
    }
  }
  properties: {
    friendlyName: '${projectName} Agent Project (${environment})'
    hubResourceId: aiHub.id
    primaryUserAssignedIdentity: managedIdentity.id
  }
}

// ============================================================
// Private DNS Zones
// ============================================================
resource openaiDnsZone 'Microsoft.Network/privateDnsZones@2020-06-01' = {
  name: 'privatelink.openai.azure.com'
  location: 'global'
  tags: tags
}

resource kvDnsZone 'Microsoft.Network/privateDnsZones@2020-06-01' = {
  name: 'privatelink.vaultcore.azure.net'
  location: 'global'
  tags: tags
}

resource storageDnsZone 'Microsoft.Network/privateDnsZones@2020-06-01' = {
  name: 'privatelink.blob.core.windows.net'
  location: 'global'
  tags: tags
}

resource openaiDnsLink 'Microsoft.Network/privateDnsZones/virtualNetworkLinks@2020-06-01' = {
  parent: openaiDnsZone
  name: '${resourcePrefix}-openai-link'
  location: 'global'
  properties: {
    virtualNetwork: { id: vnet.id }
    registrationEnabled: false
  }
}

resource kvDnsLink 'Microsoft.Network/privateDnsZones/virtualNetworkLinks@2020-06-01' = {
  parent: kvDnsZone
  name: '${resourcePrefix}-kv-link'
  location: 'global'
  properties: {
    virtualNetwork: { id: vnet.id }
    registrationEnabled: false
  }
}

resource storageDnsLink 'Microsoft.Network/privateDnsZones/virtualNetworkLinks@2020-06-01' = {
  parent: storageDnsZone
  name: '${resourcePrefix}-st-link'
  location: 'global'
  properties: {
    virtualNetwork: { id: vnet.id }
    registrationEnabled: false
  }
}

// ============================================================
// Outputs
// ============================================================
output vnetId string = vnet.id
output managedIdentityClientId string = managedIdentity.properties.clientId
output openaiEndpoint string = openai.properties.endpoint
output keyVaultUri string = keyVault.properties.vaultUri
output aiHubId string = aiHub.id
output aiProjectId string = aiProject.id
